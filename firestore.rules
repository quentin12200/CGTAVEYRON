rules_version = '2';

// Règles Firestore du site de l'UD CGT Aveyron.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Comptes autorisés à modifier le site (ajouter une adresse entre les crochets pour un nouvel administrateur).
    function estAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['leyrat.quentin@gmail.com'];
    }

    match /publications/{id} {
      allow read: if true;
      allow write: if estAdmin()
        && request.resource.data.titre is string
        && request.resource.data.titre.size() > 0
        && request.resource.data.date is string;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
