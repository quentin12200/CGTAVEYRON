rules_version = '2';

// Règles Firestore du site de l'UD CGT Aveyron.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Comptes autorisés à modifier le site (ajouter une adresse entre les crochets pour un nouvel administrateur).
    function estAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['leyrat.quentin@gmail.com'];
    }

    // Publications du fil.
    match /publications/{id} {
      allow read: if true;
      allow write: if estAdmin()
        && request.resource.data.titre is string
        && request.resource.data.titre.size() > 0
        && request.resource.data.date is string;
    }

    // Rendez-vous de l'agenda.
    match /evenements/{id} {
      allow read: if true;
      allow write: if estAdmin()
        && request.resource.data.titre is string
        && request.resource.data.date is string;
    }

    // Unions locales (page Contact).
    match /unionsLocales/{id} {
      allow read: if true;
      allow write: if estAdmin() && request.resource.data.nom is string;
    }

    // Liens et textes du site.
    match /reglages/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Bouton « ✊ Je soutiens » : un compteur par publication, un soutien par identité (anonyme ou non).
    // Le compteur ne bouge que de +1 ou -1, et seulement en même temps que le soutien de la personne.
    match /soutiens/{pub} {
      function moi() {
        return /databases/$(database)/documents/soutiens/$(pub)/par/$(request.auth.uid);
      }
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total == 1
        && !exists(moi()) && existsAfter(moi());
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['total'])
        && (
          (request.resource.data.total == resource.data.total + 1 && !exists(moi()) && existsAfter(moi()))
          || (request.resource.data.total == resource.data.total - 1 && exists(moi()) && !existsAfter(moi()))
        );

      match /par/{uid} {
        function compteur() {
          return /databases/$(database)/documents/soutiens/$(pub);
        }
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().size() == 0
          && getAfter(compteur()).data.total == (exists(compteur()) ? get(compteur()).data.total + 1 : 1);
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(compteur()).data.total == get(compteur()).data.total - 1;
      }
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
